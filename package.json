{
  "name": "glicko2-composite-opponent",
  "version": "0.0.0-semantic-release",
  "description": "Abstract Glicko-2 to team games through a composite player",
  "keywords": [
    "glicko2",
    "rating",
    "sports",
    "statistics",
    "math"
  ],
  "license": "MIT",
  "author": "Kenan Yildirim <kenan@kenany.me> (https://kenany.me/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenany/glicko2-composite-opponent.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "types": "dist/index.d.cts",
  "main": "dist/index.cjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./*.mjs": {
      "default": "./dist/*.mjs"
    },
    "./*.cjs": {
      "default": "./dist/*.cjs"
    },
    "./*": {
      "import": "./dist/*.mjs",
      "require": "./dist/*.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE.txt"
  ],
  "engines": {
    "node": "22 || 24 || >=26"
  },
  "scripts": {
    "build": "tsdown && tsc --noEmit",
    "lint": "biome check",
    "test": "vitest run",
    "publint": "publint --strict",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "cumulative-moving-average": "^1.0.0",
    "glicko2": "^1.2.2",
    "lodash.foreach": "^4.5.0",
    "lodash.isundefined": "^3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@containerbase/semantic-release-pnpm": "1.4.3",
    "@kenan/biome-config": "1.0.6",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "publint": "0.3.24",
    "semantic-release": "25.0.9",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
